# py-captions-for-channels — Intel GPU starter configuration
#
# Copy this file to .env:
#   Linux/macOS:  cp .env.example.intel .env
#   Windows:      copy .env.example.intel .env
#
# Prerequisites (Linux):
#   - Intel GPU with Quick Sync Video (Broadwell / 5th gen Core or newer;
#     Skylake / 6th gen and up is well-tested)
#   - Your user in the host's 'render'/'video' groups so /dev/dri is
#     readable (DRI_DEVICE below maps it into the container automatically —
#     no --device flag or manual docker-compose.yml edit needed). The VA-API
#     driver itself (intel-media-va-driver) is bundled inside the container
#     image — nothing extra to install on the host beyond kernel/group access.
#
# Note: Whisper transcription cannot use the Intel GPU — WHISPER_DEVICE=intel
# always falls back to CPU (no OpenVINO/Intel backend is implemented yet).
# Parakeet (WHISPER_LOCAL_ENGINE=parakeet) is a fast CPU-only alternative
# worth trying instead. Only encoding/decoding (EMBED_CAPTIONS=h264) use the
# GPU, via VA-API — not Quick Sync's proprietary API (QSV/oneVPL), which
# isn't compiled into this image; VA-API is the actual, real hardware path.
#
# For the full list of every available option see .env.example

# ── Required ──────────────────────────────────────────────────────────────────

# Your Channels DVR server address
CHANNELS_DVR_URL=http://YOUR_DVR_IP:8089

# ── Recordings path ───────────────────────────────────────────────────────────
# Must be set before deploying. See WINDOWS_SETUP.md Step 3 for Windows details.
# CHOOSE ONE option below — comment out the other.
#
# Option A ── DVR is on THIS machine ──────────────────────────────────────────
# ← Fill in the path to your recordings folder (Windows: C:/Channels/DVR)
DVR_MEDIA_TYPE=none
DVR_MEDIA_DEVICE=
DVR_MEDIA_OPTS=bind
DVR_MEDIA_MOUNT=/mnt/media
#
# Option B ── DVR is on a DIFFERENT machine (NAS / Linux / another PC) ────────
# Step 1 — store credentials once in PowerShell (keeps passwords out of files):
#   cmdkey /add:YOUR_DVR_SERVER /user:USERNAME /pass:PASSWORD
# Step 2 — optionally map a persistent drive letter (recommended):
#   net use Z: \\YOUR_DVR_SERVER\YOUR_SHARE /persistent:yes
# Step 3 — comment out Option A above, then uncomment and fill in below:
# DVR_MEDIA_HOST_PATH=Z:/        # drive letter from Step 2, or //YOUR_DVR_SERVER/YOUR_SHARE
# DVR_MEDIA_MOUNT=/mnt/media
# DVR_PATH_PREFIX=               # set via Setup Wizard after first deploy
#
# NOTE: LOCAL_PATH_PREFIX is derived from DVR_MEDIA_MOUNT automatically.

# ── GPU ───────────────────────────────────────────────────────────────────────
# No special DOCKER_RUNTIME needed for Intel. DRI_DEVICE maps /dev/dri into
# the container (docker-compose.yml's `devices:` section) — this is the one
# line that actually turns on GPU passthrough for this profile.
DRI_DEVICE=/dev/dri
WHISPER_DEVICE=cpu          # Transcription always runs on CPU on Intel — see note above
HWACCEL_DECODE=auto         # Picks VA-API (Intel's actual supported path — see note above; only applies when EMBED_CAPTIONS=h264)
GPU_ENCODER=auto            # Picks VA-API encode (only applies when EMBED_CAPTIONS=h264)

# ── Whisper model ─────────────────────────────────────────────────────────────
WHISPER_MODEL=small.en

# ── Safety ────────────────────────────────────────────────────────────────────
DRY_RUN=true
